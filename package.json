{
  "name": "enotes",
  "productName": "E-Notes",
  "version": "1.1.6",
  "description": "E-Notes: write by hand next to your PDFs, synced across Windows, Linux, Android and the web. Created by Md. Towfiq Bin Hasan and TH team.",
  "author": {
    "name": "Md. Towfiq Bin Hasan and TH team",
    "email": "136582948+towfiqbinhasan@users.noreply.github.com"
  },
  "homepage": "https://github.com/towfiqbinhasan/E-Notes",
  "desktopName": "e-notes.desktop",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "preview": "vite preview",
    "electron:dev": "npm run assets && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "electron:build": "npm run build && electron-builder --win --linux",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:publish": "npm run build && electron-builder --win --linux --publish always",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "idb": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "perfect-freehand": "^1.2.3",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
